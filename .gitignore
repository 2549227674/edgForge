# Large, reproducible local assets.  Record their hashes and provenance in
# versioned manifests/configuration; do not commit the assets themselves.
/data/archive/
/data/eval/
/models/
# Third-party source trees are represented by pinned submodules. Ignore any
# additional local dependency checkout unless it is explicitly force-added.
/third_party/
/rknn-llm-release-v*.zip

# Local virtual machines and task-specific Python environments.
/vm/
/.venv-bfcl/
/.venv-lmeval/
/.venv-data/

# Local task transcripts are kept for reference but are not project sources.
/docs/1.md
/tmp/
/logs/w0/
/tasks/worktrees/

# Python environments and transient tooling state.
/.venv/
/venv/
/.pytest_cache/
/__pycache__/
*.py[cod]

# Generated model-conversion and benchmark artifacts.  Commit only the
# explicitly selected, small reproducibility snapshots (for example lock.json).
/results/
*.gguf
*.rkllm

